# ================================================================
# VARIÁVEIS DE AMBIENTE — COPIE PARA A VERCEL (Settings > Env Vars)
# ================================================================
# NÃO commite o arquivo .env com valores reais no Git!
# Este arquivo é apenas um guia de quais variáveis configurar.

# ------------------------------------------------------------
# FIREBASE — Banco de dados principal (obrigatório em produção)
# ------------------------------------------------------------
FIREBASE_API_KEY=sua_api_key_aqui
FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
FIREBASE_PROJECT_ID=seu_projeto_id
FIREBASE_STORAGE_BUCKET=seu_projeto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------
# AUTENTICAÇÃO JWT — Crie uma string longa e aleatória (min 32 chars)
# Exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET=cole_aqui_sua_string_secreta_longa

# ------------------------------------------------------------
# CLOUDINARY — Upload de imagens (avatar, chat, prisional etc.)
# Encontre em: cloudinary.com > Dashboard
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key_numerica
CLOUDINARY_API_SECRET=seu_api_secret

# ------------------------------------------------------------
# CORS — URL do seu deploy na Vercel (sem barra no final)
# Preencha após o primeiro deploy para reforçar segurança
# Exemplo: https://painel-policia-front.vercel.app
# ------------------------------------------------------------
ALLOWED_ORIGIN=https://seu-projeto.vercel.app

# ------------------------------------------------------------
# BANCO LOCAL — Apenas para desenvolvimento local sem Firebase
# Deixe como false em produção (Vercel)
# ------------------------------------------------------------
USE_LOCAL_DB=false
