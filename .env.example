# ========================================================
# VARIÁVEIS DE AMBIENTE DA VERCEL (NÃO COMITE ESTE ARQUIVO)
# ========================================================

# Chaves do Banco de Dados Firebase (Obrigatório para Produção)
FIREBASE_API_KEY=sua_api_key_aqui
FIREBASE_AUTH_DOMAIN=seu_auth_domain_aqui
FIREBASE_PROJECT_ID=seu_project_id_aqui
FIREBASE_STORAGE_BUCKET=seu_storage_bucket_aqui
FIREBASE_MESSAGING_SENDER_ID=seu_messaging_sender_id_aqui
FIREBASE_APP_ID=seu_app_id_aqui
FIREBASE_MEASUREMENT_ID=seu_measurement_id_aqui

# Segredo de Autenticação JWT (Crie uma string longa e aleatória)
JWT_SECRET=super_secret_jwt_key_aqui

# Comportamento de Banco (true para rodar local sem Firebase)
USE_LOCAL_DB=false
